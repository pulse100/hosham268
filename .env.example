# ── Supabase (قاعدة البيانات + تسجيل دخول الإدارة + رفع الصور) ──
# إذا تُركت فارغة يعمل الموقع بالبيانات الموثقة الموجودة في src/lib/seed.ts (بدون لوحة إدارة).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# رابط الموقع النهائي (للـ SEO و sitemap و Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# ── اختياري: YouTube Data API لجلب مدة الفيديوهات ──
# بدونه تُجلب آخر الفيديوهات من RSS القناة (بدون المدة) + الفيديوهات المضافة من لوحة الإدارة.
YOUTUBE_API_KEY=
